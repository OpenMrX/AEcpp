# clangd 配置（编辑器的 clangd 扩展已通过 --compile-commands-dir 指向 build/llvm 的编译数据库）

# 对 modules/ 下的 .cppm：当前未接入构建（见 Docs/PLAN_module_migration.md §11），
# 这里补充项目自有包含路径，使内部 import/头能解析（第三方全局片段头仍需 vcpkg 路径）。
If:
  PathMatch: modules/.*\.cppm
CompileFlags:
  Add:
    - "-Iinclude"
    - "-Ivendor"
    - "-std=c++20"
  Compiler: clang-cl.exe

Diagnostics:
  # 关闭“未使用头文件”严格检查，避免 vcpkg/MSVC 头带来噪音
  UnusedIncludes: None
